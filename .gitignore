# https://git-scm.com/docs/gitignore

# Environments
.env
**/.venv/

# Python caches and build output
**/__pycache__/
**/*.py[co]
**/.pytest_cache/
**/.ruff_cache/
**/.ty_cache/
**/dist/
.coverage
htmlcov/

# Node
**/node_modules/

# Go build output and coverage profiles
**/bin/
coverage.out

# Docs site (Hugo output, module vendor tree, asset pipeline cache, build lock).
# The theme is pinned in go.mod, so _vendor/ stays a local convenience: vendoring it
# would turn a theme bump from a lockfile diff into a 1.1 MB source diff.
/site/
# Hugo's default output dir, used when --destination is omitted. The comment sits
# on its own line: gitignore has no trailing-comment syntax, so an inline one
# becomes part of the pattern and silently stops matching.
/public/
/_vendor/
/resources/
.hugo_build.lock
/.cache/

# Scratch
.agents/tmp/
tmp/

# OpenTofu local state and provider caches
**/.terraform/
**/.terraform.tfstate.lock.info
**/*.tfstate
**/*.tfstate.*
**/tfplan
**/*.tfplan
**/.tflint.d/
# Real variable files hold the operator's public control-plane IP; only the
# committed *.tfvars.example template is tracked (it does not match this glob).
**/*.tfvars

# ADK eval history (generated by `adk eval`)
**/.adk/
**/.state/
agents/python/evals/*-eval.log
agents/python/evals/*-observed.json
agents/python/evals/model.json

# SQLite state snapshots (generated by infra/scripts/backup-state.sh)
**/.state-backups/

# MLflow local tracking store + runs (generated by `mise run eval:mlflow`, Ch. 4.4/7.0)
**/mlflow.db
**/mlruns/

# Demo-only gateway auth material: self-signed TLS certificate plus JWT signing
# key/JWKS generated by infra/scripts/gateway-{tls,jwt}.sh (Ch. 5.5)
infra/agentgateway/host/auth/

# SOPS lab material (infra/scripts/secrets.sh, Ch. 6.5): only ciphertext under
# infra/**/secrets/ is committed; age private keys and decrypted output are not
infra/secrets/
**/*.agekey
**/*.dec.yaml
